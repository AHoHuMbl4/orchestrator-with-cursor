{
  "task": {
    "description_file": ".orchestration/compass.md"
  },
  "execution": {
    "executor": "auto",
    "on_cursor_fail": "ask",
    "parallel_per_task": 3,
    "timeout_s": 1800,
    "retry_on_fail": 1,
    "ask_before_runs": 20
  },
  "review": {
    "reviewers_per_diff": 3,
    "max_rounds": 3
  },
  "orchestrator": {
    "claude": "default",
    "claude_effort": "high",
    "codex": "default",
    "codex_effort": "high",
    "budget_usd": 20
  },
  "reground": {
    "every_min": 10,
    "every_n_calls": 40,
    "compact_reground": true
  },
  "panel": {
    "host": "127.0.0.1",
    "port": 8765
  }
}
